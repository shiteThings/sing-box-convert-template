        ],
        "action": "route",
        "outbound": "Streaming"
      },


      {
        "rule_set": [
          "ChinaDomain"
        ],
        "action": "route",
        "outbound": "Direct"
      },


      {
        "rule_set": [
          "ChinaIP"
        ],
        "action": "route",
        "outbound": "Direct"
      },


      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "Direct"
      }

    ],


    "rule_set": [

      {
        "type": "remote",

        "tag": [
          "Reject",
          "Ads_AWAvenue",
          "Proxy",
          "AI",
          "Telegram",
          "Twitter",
          "Facebook",
          "TikTok",
          "Steam",
