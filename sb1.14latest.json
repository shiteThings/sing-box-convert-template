      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },


    {
      "tag": "TikTok",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "Direct"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },


    {
      "tag": "Game",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "Direct"
      ],
      "interrupt_exist_connections": true
    },


    {
      "tag": "Emby",
      "type": "selector",
      "outbounds": [
        "Proxy",
